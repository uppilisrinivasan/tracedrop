{
  "name": "@tracedrop/backend",
  "version": "1.0.0",
  "description": "TraceDrop Backend - Blood Donor Care Platform with AI-Powered Health Monitoring",
  "main": "src/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "init:db": "ts-node src/database/firestore-init.ts",
    "init:db:generate-indexes": "ts-node src/database/firestore-init.ts --generate-indexes",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "firebase:indexes": "gcloud firestore indexes create firestore-indexes.yaml",
    "emulator:start": "firebase emulators:start --only firestore",
    "emulator:clear": "firebase emulators:start --only firestore --import=./emulator-data"
  },
  "keywords": [
    "blood-donor",
    "healthcare",
    "firestore",
    "firebase",
    "ai",
    "health-monitoring",
    "care-plan"
  ],
  "author": "TraceDrop Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "bottleneck": "^2.19.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.0",
    "firebase-admin": "^11.11.0",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.1",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
