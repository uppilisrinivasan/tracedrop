# =============================================================================
# Phase 3: AI Agents Configuration
# =============================================================================

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Rate Limiting & Budget Management
LLM_RATE_LIMIT_RPS=10
LLM_RATE_LIMIT_TOKENS_PER_DAY=100000

# Fallback & Resilience
ENABLE_TEMPLATE_FALLBACK=true
ENABLE_ONTOLOGY_AUGMENTATION=true
ENABLE_LLM_CACHING=true

# Logging & Monitoring
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
ENABLE_RATE_LIMIT_LOGGING=true

# Medical Safety
MEDICAL_SAFETY_MODE=strict
REQUIRE_HUMAN_REVIEW_FOR_URGENT=true
MAX_ESCALATION_TIME_MINUTES=30

# Ontology Configuration
ONTOLOGY_PATH=./data/ontology
AUTO_LOAD_ONTOLOGY=true

# External Services
SPEECH_TO_TEXT_SERVICE=google_cloud
IMAGE_OCR_SERVICE=tesseract
MAP_SERVICE=google_maps

# Message Delivery Channels
WHATSAPP_INTEGRATION_ENABLED=true
SMS_INTEGRATION_ENABLED=true
EMAIL_INTEGRATION_ENABLED=true
APP_NOTIFICATION_ENABLED=true

# Firebase Configuration
FIREBASE_PROJECT_ID=tracedrop-project
FIREBASE_PRIVATE_KEY_ID=key-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase@tracedrop.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Performance Tuning
CACHE_TTL_SECONDS=3600
BATCH_PROCESSING_ENABLED=true
BATCH_SIZE=100

# Feature Flags
FEATURE_NAVIGATOR_AGENT=true
FEATURE_MESSAGE_GENERATOR=true
FEATURE_RECORD_BUILDER=true
FEATURE_MULTIMODAL_INPUT=true
FEATURE_VOICE_SUPPORT=true
FEATURE_IMAGE_EXTRACTION=true

# Quality Assurance
ENABLE_PERFORMANCE_METRICS=true
ENABLE_ERROR_TRACKING=true
ENABLE_AUDIT_LOGGING=true
