{
  "cardiovascular_tests": {
    "blood_pressure": {
      "unit": "mmHg",
      "measurement": "Systolic/Diastolic",
      "categories": {
        "normal": {
          "range": "<120/<80",
          "risk_level": "optimal",
          "action": "Continue healthy lifestyle"
        },
        "elevated": {
          "range": "120-139/80-89",
          "risk_level": "low",
          "action": "Lifestyle modification, recheck in 3-6 months"
        },
        "grade1_hypertension": {
          "range": "140-159/90-99",
          "risk_level": "moderate",
          "action": "Consider medication, lifestyle modification"
        },
        "grade2_hypertension": {
          "range": "160-179/100-109",
          "risk_level": "high",
          "action": "Initiate medication and lifestyle modification"
        },
        "grade3_hypertension": {
          "range": ">=180/>=120",
          "risk_level": "critical",
          "action": "Emergency evaluation required"
        }
      }
    },
    "cholesterol": {
      "unit": "mg/dL",
      "categories": {
        "desirable": {
          "range": "<200",
          "risk_level": "optimal",
          "action": "Continue current lifestyle"
        },
        "borderline_high": {
          "range": "200-239",
          "risk_level": "moderate",
          "action": "Lifestyle modification, recheck in 6-12 months"
        },
        "high": {
          "range": ">=240",
          "risk_level": "high",
          "action": "Consider medication, intensive lifestyle modification"
        }
      }
    },
    "LDL": {
      "unit": "mg/dL",
      "optimal": "<100",
      "near_optimal": "100-129",
      "borderline_high": "130-159",
      "high": "160-189",
      "very_high": ">=190"
    },
    "HDL": {
      "unit": "mg/dL",
      "high_male": ">40",
      "high_female": ">50",
      "low_male": "<40",
      "low_female": "<50",
      "note": "Higher HDL is better for cardiovascular health"
    },
    "triglycerides": {
      "unit": "mg/dL",
      "normal": "<150",
      "borderline_high": "150-199",
      "high": "200-499",
      "very_high": ">=500"
    },
    "troponin": {
      "unit": "ng/mL",
      "normal": "<0.04",
      "elevated": ">=0.04",
      "note": "Use for acute MI detection, serial measurements important"
    }
  },
  "metabolic_tests": {
    "fasting_glucose": {
      "unit": "mg/dL",
      "normal": "<100",
      "prediabetic": "100-125",
      "diabetic": ">=126",
      "timing": "After 8-12 hour fast"
    },
    "random_glucose": {
      "unit": "mg/dL",
      "normal": "<140",
      "diabetic_diagnostic": ">=200 with symptoms"
    },
    "post_prandial_glucose": {
      "unit": "mg/dL",
      "normal": "<140",
      "prediabetic": "140-199",
      "diabetic": ">=200",
      "timing": "2 hours after meal"
    },
    "HbA1c": {
      "unit": "%",
      "normal": "<5.7",
      "prediabetic": "5.7-6.4",
      "diabetic": ">=6.5",
      "target_for_diabetics": "<7 (individualize)",
      "reflects": "Average blood glucose over 2-3 months"
    },
    "fasting_insulin": {
      "unit": "mIU/mL",
      "normal": "2-12",
      "elevated": ">12",
      "indicates": "Insulin resistance if elevated with normal glucose"
    },
    "HOMA_IR": {
      "formula": "(Fasting insulin (mIU/mL) x Fasting glucose (mmol/L)) / 22.5",
      "normal": "<2",
      "insulin_resistant": ">=2",
      "indicates": "Insulin resistance"
    }
  },
  "hematologic_tests": {
    "hemoglobin": {
      "unit": "g/dL",
      "normal_male": "13.5-17.5",
      "normal_female": "12.0-15.5",
      "normal_elderly": "12.0-15.5",
      "mild_anemia": "10.0-12.0",
      "moderate_anemia": "7.0-10.0",
      "severe_anemia": "<7.0"
    },
    "hematocrit": {
      "unit": "%",
      "normal_male": "41-53",
      "normal_female": "36-46",
      "normal_elderly": "36-46",
      "mild_anemia": "30-36",
      "moderate_anemia": "21-30",
      "severe_anemia": "<21"
    },
    "red_blood_cell_count": {
      "unit": "10^6/microliter",
      "normal_male": "4.7-6.1",
      "normal_female": "4.2-5.4"
    },
    "mean_corpuscular_volume": {
      "unit": "fL",
      "normal": "80-100",
      "microcytic": "<80",
      "macrocytic": ">100"
    },
    "reticulocyte_count": {
      "unit": "%",
      "normal": "0.5-2.5",
      "reflects": "Bone marrow response to anemia"
    },
    "ferritin": {
      "unit": "ng/mL",
      "normal_male": "30-400",
      "normal_female": "15-200",
      "low": "<30 indicates iron deficiency",
      "high": ">400 indicates iron overload"
    },
    "serum_iron": {
      "unit": "micrograms/dL",
      "normal_male": "60-170",
      "normal_female": "50-150"
    },
    "TIBC": {
      "unit": "micrograms/dL",
      "normal": "250-425",
      "elevated_in": "Iron deficiency anemia"
    }
  },
  "renal_tests": {
    "creatinine": {
      "unit": "mg/dL",
      "normal_male": "0.7-1.3",
      "normal_female": "0.6-1.2",
      "note": "Increases with age and muscle mass"
    },
    "BUN": {
      "unit": "mg/dL",
      "normal": "7-20",
      "elevated": ">20 suggests renal dysfunction"
    },
    "eGFR": {
      "unit": "mL/min/1.73m2",
      "stage1": ">=90 (normal or high)",
      "stage2": "60-89 (mildly decreased)",
      "stage3a": "45-59 (mildly to moderately decreased)",
      "stage3b": "30-44 (moderately to severely decreased)",
      "stage4": "15-29 (severely decreased)",
      "stage5": "<15 (kidney failure)",
      "formula": "MDRD or CKD-EPI equation"
    },
    "albumin_creatinine_ratio": {
      "unit": "mg/g or mg/mmol",
      "normal": "<30 mg/g",
      "microalbuminuria": "30-300 mg/g",
      "macroalbuminuria": ">300 mg/g"
    },
    "urine_protein": {
      "unit": "g/24h",
      "normal": "<0.15",
      "proteinuria": ">0.15"
    }
  },
  "liver_tests": {
    "ALT": {
      "unit": "U/L",
      "normal_male": "<40",
      "normal_female": "<32",
      "elevated": "Suggests liver injury"
    },
    "AST": {
      "unit": "U/L",
      "normal_male": "<40",
      "normal_female": "<32"
    },
    "bilirubin_total": {
      "unit": "mg/dL",
      "normal": "<1.2"
    },
    "alkaline_phosphatase": {
      "unit": "U/L",
      "normal_male": "<40",
      "normal_female": "<32"
    }
  },
  "inflammatory_markers": {
    "CRP": {
      "unit": "mg/L",
      "normal": "<3",
      "low_grade_inflammation": "3-10",
      "high_inflammation": ">10",
      "elevated_in": "Infection, inflammation, CVD risk"
    },
    "ESR": {
      "unit": "mm/hour",
      "normal_male": "<15",
      "normal_female": "<20",
      "elevated_in": "Inflammation, infection, autoimmune disease"
    }
  },
  "thyroid_tests": {
    "TSH": {
      "unit": "mIU/L",
      "normal": "0.4-4.0",
      "hypothyroidism": ">4.0",
      "hyperthyroidism": "<0.4"
    },
    "T4_free": {
      "unit": "pg/mL",
      "normal": "0.8-1.8"
    },
    "T3_free": {
      "unit": "pg/mL",
      "normal": "2.3-4.2"
    }
  }
}
