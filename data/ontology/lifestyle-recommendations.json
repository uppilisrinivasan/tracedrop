{
  "hypertension_grade1": {
    "title": "Lifestyle Modifications for Grade 1 Hypertension",
    "source": "ICMR Guidelines, ACC/AHA 2017",
    "recommendations": [
      {
        "intervention": "Dietary Sodium Restriction",
        "target": "Reduce to 2300 mg/day or less",
        "expectedReduction": "2-8 mmHg systolic",
        "duration": "Ongoing",
        "difficulty": "moderate",
        "tips": ["Check food labels", "Avoid processed foods", "Use herbs for seasoning", "Cook at home more often"]
      },
      {
        "intervention": "DASH Diet",
        "target": "Rich in fruits, vegetables, whole grains, low-fat dairy",
        "expectedReduction": "8-14 mmHg systolic",
        "duration": "Ongoing",
        "difficulty": "moderate",
        "tips": ["Increase fruits to 4-5 servings/day", "Increase vegetables to 4-5 servings/day", "Choose whole grains", "Include low-fat dairy products"]
      },
      {
        "intervention": "Aerobic Exercise",
        "target": "150 minutes moderate-intensity per week",
        "expectedReduction": "5-7 mmHg systolic",
        "duration": "At least 30 min, 5 days/week",
        "difficulty": "moderate",
        "examples": ["Brisk walking", "Jogging", "Cycling", "Swimming"]
      },
      {
        "intervention": "Weight Loss",
        "target": "Reduce body weight by 5-10% if overweight",
        "expectedReduction": "2-10 mmHg per 10 kg lost",
        "duration": "6-12 months",
        "difficulty": "high",
        "tips": ["Calculate current BMI", "Set realistic goals", "Track progress", "Consider referral to nutritionist"]
      },
      {
        "intervention": "Alcohol Moderation",
        "target": "Limit to 14 units/week (males), 7 units/week (females)",
        "expectedReduction": "2-4 mmHg",
        "duration": "Ongoing",
        "difficulty": "moderate",
        "definition": "1 unit = 10 mL pure alcohol"
      },
      {
        "intervention": "Stress Management",
        "target": "10-20 minutes daily relaxation practice",
        "expectedReduction": "2-5 mmHg",
        "duration": "Ongoing",
        "difficulty": "easy_to_moderate",
        "techniques": ["Deep breathing", "Meditation", "Yoga", "Progressive muscle relaxation", "Tai Chi"]
      },
      {
        "intervention": "Sleep Optimization",
        "target": "7-9 hours quality sleep per night",
        "expectedReduction": "1-3 mmHg",
        "duration": "Ongoing",
        "difficulty": "moderate",
        "tips": ["Maintain regular sleep schedule", "Avoid screens 1 hour before bed", "Keep bedroom cool and dark"]
      }
    ]
  },
