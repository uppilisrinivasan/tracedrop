# Anthropic API Configuration
ANTHROPIC_API_KEY=

# LLM Rate Limiting. Same caps as Cloud Run.
LLM_RATE_LIMIT_RPS=2
LLM_RATE_LIMIT_TOKENS_PER_DAY=50000
LLM_MAX_CALLS_PER_DAY=200

# Vertex AI. No API key: Cloud Run uses its service account, a laptop uses
# Application Default Credentials. See docs/RUN_LOCALLY.md.
# Leave GOOGLE_CLOUD_PROJECT empty to keep the rule-based AI fallback.
GOOGLE_CLOUD_PROJECT=project-6055aa98-bf59-48b5-a50
VERTEX_LOCATION=global
LLM_MODEL=gemini-2.5-flash-lite

# Firebase/Firestore Configuration
# Leave FIRESTORE_EMULATOR_HOST unset to use the Cloud Firestore access log.
# FIRESTORE_EMULATOR_HOST=localhost:8081
GCP_PROJECT=project-6055aa98-bf59-48b5-a50

# Application Configuration
NODE_ENV=development
PORT=8080

# Local development only. Skip Google sign-in and the access log.
# Cloud Run sets NODE_ENV=production, which ignores this flag.
AUTH_DISABLED=true

# Required when AUTH_DISABLED is not true.
# GOOGLE_CLIENT_ID is the OAuth web client ID (it is public).
# SESSION_SECRET signs the 10-minute session cookie.
GOOGLE_CLIENT_ID=
SESSION_SECRET=

# Neo4j Configuration (optional)
NEO4J_AUTH=none
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api
