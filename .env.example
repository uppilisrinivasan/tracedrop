# Anthropic API Configuration
ANTHROPIC_API_KEY=

# LLM Rate Limiting
LLM_RATE_LIMIT_RPS=10
LLM_RATE_LIMIT_TOKENS_PER_DAY=100000

# Firebase/Firestore Configuration
# Leave FIRESTORE_EMULATOR_HOST unset to use the Cloud Firestore access log.
# FIRESTORE_EMULATOR_HOST=localhost:8081
GCP_PROJECT=tracedrop-dev

# Application Configuration
NODE_ENV=development
PORT=8080

# Local development only. Skip Google sign-in and the access log.
# Cloud Run sets NODE_ENV=production, which ignores this flag.
AUTH_DISABLED=true

# Required when AUTH_DISABLED is not true.
# GOOGLE_CLIENT_ID is the OAuth web client ID (it is public).
# SESSION_SECRET signs the 10-minute session cookie.
GOOGLE_CLIENT_ID=
SESSION_SECRET=

# Neo4j Configuration (optional)
NEO4J_AUTH=none
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api
